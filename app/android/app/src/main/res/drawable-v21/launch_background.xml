<?xml version="1.0" encoding="utf-8"?>
<!--
  The first frame the phone draws, before Flutter is alive.

  It was white. This app is dark-only and gets opened in a basement between
  sets, so every launch was a full-screen white flash straight into a dark
  UI. It is now AppTheme.bg, which makes the launch invisible.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
</layer-list>
