<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rest-timer notifications. Android 13+ asks at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!--
      EXACT alarms. Without these the rest timer fires late or not at all on
      Android 12+, which is the difference between a 2:30 rest and "whenever
      Android feels like it". v1's plan mentioned POST_NOTIFICATIONS only.
      USE_EXACT_ALARM is granted at install for an alarm/timer app; the
      SCHEDULE_EXACT_ALARM fallback covers older targets.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <!-- Re-arm a pending rest timer after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Keeps the screen on while a session is in progress. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Ask to be exempt from battery optimisation, or OEM killers stop the timer. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!--
      NETWORK: map tiles only (v3, approved by Saad on 2026-09-23).
      The run tracker draws its trail over OpenStreetMap, and tiles come from
      tile.openstreetmap.org. That is the ONLY host the app talks to. Nothing
      is ever uploaded: not a set, not a weigh-in, not a photo, not a GPS
      point. Requesting a tile does tell the tile server roughly which area is
      on screen — that is the price of a street map, and it was accepted.
      test/privacy_audit_test.dart enforces the "tiles only" part.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      GPS run tracking. FINE for a usable trail (COARSE must be declared
      alongside it on Android 12+). FOREGROUND_SERVICE_LOCATION lets the
      tracker keep recording with the phone in a pocket and the screen off —
      it runs as a visible "Run in progress" notification, started from a tap
      in the app.

      Deliberately NOT declared: ACCESS_BACKGROUND_LOCATION. A foreground
      service started while the app is visible does not need it, and without
      it the app cannot see location at any other time.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>

    <application
        android:label="Keller Twelve"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true">
        <!--
          allowBackup="false" is a HARD requirement, not a preference.
          Left at the default, Android silently uploads app-private storage —
          including every progress photo — to the user's Google Drive backup.
          The backup_rules files are belt and braces for the same thing.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- flutter_local_notifications: fire while the screen is off. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
