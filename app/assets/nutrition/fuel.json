  "buyingGuide": [
    {
      "title": "Meat",
      "body": "The halal butcher, or the supermarket's halal line. Lidl and Rewe both stock halal chicken in most Münster branches; the Turkish grocers on Wolbecker Straße are cheaper and better."
    },
    {
      "title": "Cheese",
      "body": "Look for mikrobielles Lab or vegetarisches Lab on the label. Animal rennet is the default in a lot of German cheese and it is usually calf."
    },
    {
      "title": "Gelatine",
      "body": "In yoghurts, gummy sweets, some protein bars and a lot of desserts. If the label says Gelatine without saying Rind, assume pork."
    },
    {
      "title": "Flavourings",
      "body": "Vanilla extract and some flavoured whey carry alcohol as a carrier. Neutral whey avoids the question entirely."
    },
    {
      "title": "Reading a label",
      "body": "Nährwerte je 100 g is what this plan is built on. Compare per 100 g, never per portion — the portion on the packet is whatever flatters the number."
    }
  ]
}
