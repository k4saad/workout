  "supplements": [
    {
      "id": "creatine",
      "name": "Creatine monohydrate",
      "dose": "5 g",
      "timing": "any time, daily",
      "note": "The only supplement here with strong evidence behind it. Unflavoured monohydrate; nothing else is worth the money."
    },
    {
      "id": "vitamin_d",
      "name": "Vitamin D3",
      "dose": "1000-2000 IU",
      "timing": "with a meal containing fat",
      "note": "Münster, indoors, training in a basement. Between October and March almost everyone at this latitude is short of it."
    },
    {
      "id": "whey_supp",
      "name": "Whey protein",
      "dose": "1 scoop",
      "timing": "straight after training",
      "note": "Convenience, not magic. It is there so the post-training 25 g happens on a night you cannot face cooking."
    }
  ],
  "hydration": {
    "dailyMl": 3000,
    "trainingExtraMl": 700,
    "note": "Three litres, plus about 700 ml across a session. Dark urine in the morning means yesterday was short."
  },
  "buyingGuide": [
    {
      "title": "Meat",
      "body": "The halal butcher, or the supermarket's halal line. Lidl and Rewe both stock halal chicken in most Münster branches; the Turkish grocers on Wolbecker Straße are cheaper and better."
    },
    {
      "title": "Cheese",
      "body": "Look for microbial or vegetarian rennet — on a German label, mikrobielles Lab or vegetarisches Lab. Animal rennet is the default in a lot of German cheese and it is usually calf."
    },
    {
      "title": "Gelatine",
      "body": "In yoghurts, gummy sweets, some protein bars and a lot of desserts. If the label says gelatine without saying beef (Rind), assume pork."
    },
    {
      "title": "Flavourings",
      "body": "Vanilla extract and some flavoured whey carry alcohol as a carrier. Neutral whey avoids the question entirely."
    },
    {
      "title": "Reading a label",
      "body": "The nutrition per 100 g (Nährwerte je 100 g) is what this plan is built on. Compare per 100 g, never per portion — the portion on the packet is whatever flatters the number."
    }
  ],
