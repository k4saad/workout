  "startDate": "2026-09-21",
  "totalWeeks": 12,
  "notes": "Beginner hypertrophy block for a 167 cm / 50 kg lifter training alone five evenings a week in a basement gym. Cardio is deliberately capped so it doesn't eat the caloric surplus. Loads in startLoadKg INCLUDE the bar — correct the bar weights in Settings once you have weighed them.",
  "athlete": {
    "startWeightKg": 50.0,
    "heightCm": 167,
    "targetWeightKg": 55.0,
    "experience": "beginner",
    "trainsAlone": true
  },
  "nutritionTargets": {
    "kcal": 2700,
    "proteinG": 110,
    "carbsG": 375,
    "fatG": 75,
    "gainKgPerWeek": 0.3,
    "flatWeeksBeforeBump": 2,
    "kcalBumpWhenFlat": 300
  },
  "rules": [
    "Eat in surplus every single day. A missed meal is a missed session.",
    "Leave 2 reps in the tank — 3 to 4 during weeks 1 to 4.",
    "Collars on. Check them mid-set. Spinlock collars work loose under load.",
    "Never fail alone under a bar. Set the catch pins, or press dumbbells.",
    "Add weight only when you earn it: top of the rep range on every set, then +2.5 kg.",
    "Log every set. A session you didn't log is a session you can't beat next week."
  ],
  "cardioProgression": [
    { "weeks": [1, 2],   "longRunMin": [15, 20], "secondRunMin": null,   "skipping": "6 × 1 min",      "note": "Calves and Achilles need four weeks to adapt. Don't rush this." },
    { "weeks": [3, 4],   "longRunMin": [20, 25], "secondRunMin": null,   "skipping": "6 × 90 s",       "note": "Tuesday easy run is in the Foundation week already." },
    { "weeks": [5, 6],   "longRunMin": [25, 25], "secondRunMin": [20, 20], "skipping": "8 × 30 s fast", "note": "Skipping becomes warm-up on lifting days." },
    { "weeks": [7],      "longRunMin": [30, 30], "secondRunMin": [20, 20], "skipping": "8 × 30 s fast", "note": "Highest cardio week before the deload." },
    { "weeks": [8],      "longRunMin": [20, 20], "secondRunMin": null,   "skipping": "5 × 1 min",      "note": "Deload. Everything comes down, including this." },
    { "weeks": [9, 10],  "longRunMin": [30, 35], "secondRunMin": [20, 25], "skipping": "10 × 30 s fast","note": "Runs get longer, never faster." },
    { "weeks": [11],     "longRunMin": [35, 35], "secondRunMin": [25, 25], "skipping": "10 × 30 s fast","note": "Last easy long run." },
    { "weeks": [12],     "longRunMin": null,     "secondRunMin": null,   "skipping": "5 × 1 min",      "note": "5K time trial replaces the Sunday run. Target 28–30 min." }
  ],
