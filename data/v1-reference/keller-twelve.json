    { "week": 8,  "expectedWeightKg": [53.0, 54.0], "items": ["Photos", "Waist measurement", "Deload week — do it properly", "Clothes should fit differently across the shoulders"] },
    { "week": 12, "expectedWeightKg": [54.0, 56.0], "items": ["Photos", "Waist measurement", "5K time trial", "Log week-12 maxes: squat, bench, deadlift, strict pull-ups", "Then run the block again with new starting loads"] }
